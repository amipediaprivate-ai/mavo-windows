{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Caevir",
  "version": "0.1.0",
  "identifier": "ai.amipedia.caevir",
  "build": {
    "beforeDevCommand": "pnpm.cmd prepare:runtimes && pnpm.cmd dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm.cmd prepare:runtimes && pnpm.cmd build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{
      "label": "main",
      "title": "Caevir",
      "width": 1440,
      "height": 900,
      "minWidth": 1040,
      "minHeight": 680,
      "resizable": true,
      "fullscreen": false,
      "center": true
    }],
    "security": {
      "csp": {
        "default-src": "'self'",
        "base-uri": "'none'",
        "connect-src": "ipc: http://ipc.localhost caevir-media: http://caevir-media.localhost",
        "font-src": "'self' caevir-media: http://caevir-media.localhost",
        "form-action": "'none'",
        "frame-ancestors": "'none'",
        "frame-src": "'none'",
        "img-src": "'self' asset: http://asset.localhost blob: data:",
        "media-src": "'self' caevir-media: http://caevir-media.localhost blob:",
        "object-src": "'none'",
        "script-src": "'self'",
        "style-src": "'self'",
        "style-src-attr": "'unsafe-inline'",
        "worker-src": "'self' blob:"
      },
      "devCsp": {
        "default-src": "'self'",
        "base-uri": "'none'",
        "connect-src": "ipc: http://ipc.localhost caevir-media: http://caevir-media.localhost http://127.0.0.1:1420 ws://127.0.0.1:1420",
        "font-src": "'self' caevir-media: http://caevir-media.localhost",
        "form-action": "'none'",
        "frame-ancestors": "'none'",
        "frame-src": "'none'",
        "img-src": "'self' asset: http://asset.localhost blob: data:",
        "media-src": "'self' caevir-media: http://caevir-media.localhost blob:",
        "object-src": "'none'",
        "script-src": "'self' http://127.0.0.1:1420",
        "style-src": "'self' http://127.0.0.1:1420",
        "style-src-attr": "'unsafe-inline'",
        "worker-src": "'self' blob:"
      },
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/thumbnails/**/*"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
      "resources": {
        "resources/ffmpeg/": "ffmpeg/",
        "resources/vgmstream/": "vgmstream/",
        "resources/rembg-runtime/": "rembg-runtime/",
        "../THIRD_PARTY_NOTICES.md": ""
    }
  }
}
